<Window x:Class="Otto.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:audio="clr-namespace:Otto.Audio"
        Title="Otto" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="True"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <DataTemplate x:Key="AppRow" DataType="{x:Type audio:AppAudio}">
            <Border x:Name="Row" Padding="10,7" Margin="6,1" CornerRadius="10" Background="Transparent" MouseWheel="Row_MouseWheel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Padding="0" Width="34" Height="34"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="Mute_Click" ToolTip="Mute / unmute">
                        <Grid Width="30" Height="30">
                            <Rectangle x:Name="IconRect" Width="28" Height="28" RadiusX="7" RadiusY="7">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="IconFallback" Text="&#xE7F8;" Style="{StaticResource Glyph}" FontSize="18" Visibility="Collapsed"/>
                            <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource DangerBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                    Visibility="{Binding Muted, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE74F;" Style="{StaticResource Glyph}" FontSize="8" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Button>

                    <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,0,-2"/>
                        <Slider Style="{StaticResource FaderSlider}" Maximum="{Binding MaxPercent}" Value="{Binding VolumePercent, Mode=TwoWay}"/>
                        <Grid Height="2" Margin="0,-4,0,0">
                            <Rectangle x:Name="Meter" Fill="{DynamicResource AccentBrush}" Opacity="0.75" RadiusX="1" RadiusY="1" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Peak}"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="PercentText" Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0:0}}" Style="{StaticResource DimText}"
                               FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="IconRect" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="IconFallback" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBoosted}" Value="True">
                    <Setter TargetName="PercentText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter TargetName="IconRect" Property="Opacity" Value="0.4"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                    <Setter TargetName="PercentText" Property="Text" Value="Muted"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Margin="16">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0"/>
        </Grid.RenderTransform>
        <!-- Drag the panel anywhere that is not a control to move it; it then stays open until closed. -->
        <Border x:Name="Panel" CornerRadius="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                MouseLeftButtonDown="Panel_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000"/>
            </Border.Effect>
            <StackPanel Margin="0,10,0,8">

                <!-- master -->
                <Border x:Name="MasterRow" Padding="10,4,10,6" Margin="6,0" CornerRadius="10" Background="Transparent" MouseWheel="MasterRow_MouseWheel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="34" Height="34" Padding="0" HorizontalAlignment="Left" Click="MasterMute_Click" ToolTip="Mute / unmute everything">
                            <TextBlock x:Name="MasterGlyph" Text="&#xE767;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{StaticResource TextBrush}"/>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Master.DeviceName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,-2"/>
                            <Slider Style="{StaticResource FaderSlider}" Maximum="{Binding Master.MaxPercent}" Value="{Binding Master.VolumePercent, Mode=TwoWay}"/>
                            <Grid Height="2" Margin="0,-4,0,0">
                                <Rectangle Fill="{DynamicResource AccentBrush}" Opacity="0.75" RadiusX="1" RadiusY="1" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Master.Peak}"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="MasterPercent" Grid.Column="2" Text="{Binding Master.VolumePercent, StringFormat={}{0:0}}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Master.IsBoosted}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="16,6,16,6"/>

                <!-- apps -->
                <ScrollViewer MaxHeight="760" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource DarkScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}" Focusable="False"/>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText" Text="Nothing is playing right now" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,14,0,16" Visibility="Collapsed"/>

                <!-- footer -->
                <Grid Margin="16,6,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="FxPill" Grid.Column="1" Style="{StaticResource PillButton}" Padding="10,4" Margin="8,0,6,0" Click="Fx_Click" Visibility="Collapsed"
                            ToolTip="Turn FxSound on or off">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FxGlyph" Text="&#xE7E8;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock x:Name="FxText" Text="FxSound"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="HintText" Grid.Column="0" Style="{StaticResource DimText}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"
                               Text="Hold Alt and scroll over any window" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="Pin_Click" ToolTip="Keep the mixer open (or just drag it somewhere)" Width="30" Height="30" Padding="0" Margin="0,0,2,0">
                        <TextBlock x:Name="PinGlyph" Text="&#xE718;" Style="{StaticResource Glyph}" FontSize="14"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="Gear_Click" ToolTip="Settings" Width="30" Height="30" Padding="0">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="15"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
